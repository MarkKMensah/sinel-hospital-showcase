# Local showcase settings only. Do not use these values in production.
DEBUG=1
SECRET_KEY=replace-with-a-unique-local-development-key
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1
DATABASE=postgres
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=sinel_showcase
SQL_USER=sinel_showcase
SQL_PASSWORD=replace-with-a-local-database-password
SQL_HOST=db
SQL_PORT=5432
POSTGRES_DB=sinel_showcase
POSTGRES_USER=sinel_showcase
POSTGRES_PASSWORD=replace-with-a-local-database-password
